# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real secrets.

# Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Direct Postgres connection (Dashboard → Project Settings → Database).
# Used only by scripts/setup-database.mjs to apply the schema + seed data.
# Percent-encode special characters in the password (e.g. '#' → '%23').
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres?sslmode=require

# Public site URL (canonical + Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional fallback: external form endpoint (only used if Supabase is NOT configured)
# NEXT_PUBLIC_FORM_ENDPOINT=

# Admin login (created by scripts/setup-database.mjs)
# ADMIN_EMAIL=admin@asim.design
# ADMIN_PASSWORD=
